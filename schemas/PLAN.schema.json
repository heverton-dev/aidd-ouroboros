{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIDD Ouroboros Plan Schema",
  "description": "Contrato deterministico de plano sintético para execução de pipelines no Kernel Ouroboros.",
  "type": "object",
  "required": [
    "plan_id",
    "version",
    "target",
    "goal",
    "steps",
    "deterministic",
    "created_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-f0-9]{8,64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "deterministic": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_index",
          "skill",
          "input_type",
          "output_contract"
        ],
        "properties": {
          "step_index": {
            "type": "integer",
            "minimum": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "input_type": {
            "type": "string",
            "minLength": 1
          },
          "output_contract": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
