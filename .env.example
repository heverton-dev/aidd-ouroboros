# ==============================================================================
# AIDD OUROBOROS — Configurações de Ambiente e Credenciais de IA
# ==============================================================================

# Modo de Execução: DRY_RUN (gera manifestos e valida esquemas) ou LIVE (chama APIs reais)
OUROBOROS_EXECUTION_MODE=DRY_RUN

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Google AI Studio)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. Google Flow / Veo 2 / Imagen 3 (Vertex AI & Google Cloud)
# Necessário para geração de vídeo e renderização de character sheets no Google Flow
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=caminho/para/service_account_credentials.json

# ------------------------------------------------------------------------------
# 3. Segredo de Handoff Criptográfico HMAC-SHA256
# ------------------------------------------------------------------------------
OUROBOROS_CRYPTO_SECRET=aidd-secret-penny-harness-2026
