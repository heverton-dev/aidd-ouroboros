{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoSynthCompositionTemplate",
  "type": "object",
  "required": ["composition_id", "fps", "resolution", "tracks"],
  "properties": {
    "composition_id": { "type": "string" },
    "fps": { "type": "integer", "enum": [30, 60] },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_pointer", "start_frame", "duration_frames"],
        "properties": {
          "kind": { "type": "string", "enum": ["avatar_video", "audio_tts", "b_roll", "captions"] },
          "source_pointer": { "type": "string" },
          "start_frame": { "type": "integer" },
          "duration_frames": { "type": "integer" }
        }
      }
    }
  }
}
