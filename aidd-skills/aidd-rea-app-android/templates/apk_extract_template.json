{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APKExtractTemplate",
  "type": "object",
  "required": ["package_name", "version_code", "entry_points", "permissions", "extracted_assets"],
  "properties": {
    "package_name": { "type": "string" },
    "version_code": { "type": "string" },
    "entry_points": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extracted_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "required": ["path", "sha256"]
      }
    }
  }
}
